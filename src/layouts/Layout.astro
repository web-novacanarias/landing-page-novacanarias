---
import "../styles/global.css";
import fontBook from "../fonts/FuturaStd-Book.otf?url";
import fontBold from "../fonts/FuturaStd-Bold.otf?url";
import Icon from "../components/Icon.astro";
import { SITE, absoluteUrl } from "../lib/site";

interface Props {
  title: string;
  description?: string;
  /** Ruta de la imagen para redes sociales (por defecto /og-image.jpg, 1200x630). */
  image?: string;
  noindex?: boolean;
  /** Objetos JSON-LD adicionales para esta pagina. */
  jsonLd?: Record<string, unknown>[];
}

const { title, description = SITE.defaultDescription, image = "/og-image.jpg", noindex = false, jsonLd = [] } = Astro.props;

// Canonical por pagina, siempre contra el dominio canonico (www).
const canonical = absoluteUrl(Astro.url.pathname);
const ogImage = absoluteUrl(image);

const nav = [
  { href: "/#servicios", label: "Servicios" },
  { href: "/#nosotros", label: "Nosotros" },
  { href: "/#sectores", label: "Sectores" },
  { href: "/#equipo", label: "Equipo" },
];
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#00236a" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preload" href={fontBook} as="font" type="font/otf" crossorigin />
    <link rel="preload" href={fontBold} as="font" type="font/otf" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Logotipo de Nova Consulting sobre fondo azul" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body class="bg-nova text-white font-sans antialiased overflow-x-clip">
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[200] focus:rounded-control focus:bg-white focus:px-4 focus:py-2 focus:font-bold focus:text-nova"
    >
      Saltar al contenido
    </a>

    <header class="fixed top-4 inset-x-0 z-50 flex justify-center px-4">
      <nav
        aria-label="Principal"
        class="relative w-full max-w-6xl rounded-3xl md:rounded-full border border-white/15 bg-nova-deep/92 px-5 py-2.5 shadow-[0_10px_30px_-10px_rgba(0,17,47,0.6)] backdrop-blur-xl"
      >
        <div class="flex items-center justify-between">
          <a href="/" aria-label="Nova Consulting, inicio" class="flex min-h-11 items-center">
            <img
              src="/nova-logo.avif"
              alt="Nova Consulting"
              width="512"
              height="218"
              class="h-9 md:h-10 w-auto"
              fetchpriority="high"
            />
          </a>

          <ul class="hidden md:flex items-center gap-8 text-sm font-medium text-sky-soft">
            {nav.map((item) => (
              <li>
                <a href={item.href} class="inline-block py-3.5 transition-colors hover:text-white">{item.label}</a>
              </li>
            ))}
          </ul>

          <div class="flex items-center gap-3">
            <a
              href="/#contacto"
              class="hidden md:inline-flex min-h-11 items-center rounded-full bg-white px-5 py-2 text-sm font-bold text-nova transition-transform hover:scale-[1.03] active:scale-95"
            >
              Contacto
            </a>
            <button
              type="button"
              id="menu-toggle"
              class="md:hidden grid size-11 place-items-center rounded-control text-white"
              aria-label="Abrir menú"
              aria-expanded="false"
              aria-controls="mobile-menu"
            >
              <span data-icon="open"><Icon name="list" weight="bold" class="size-6" /></span>
              <span data-icon="close" hidden><Icon name="x" weight="bold" class="size-6" /></span>
            </button>
          </div>
        </div>

        <div
          id="mobile-menu"
          class="md:hidden invisible absolute inset-x-0 top-full mt-2 origin-top -translate-y-2 scale-y-95 rounded-3xl border border-white/15 bg-nova-deep p-6 opacity-0 shadow-2xl transition-[opacity,transform,visibility] duration-300 ease-out-expo data-[open=true]:visible data-[open=true]:translate-y-0 data-[open=true]:scale-y-100 data-[open=true]:opacity-100"
        >
          <ul class="flex flex-col text-lg font-medium">
            {nav.map((item) => (
              <li class="border-b border-white/10 last:border-0">
                <a href={item.href} class="mobile-link block py-3.5 text-sky-soft hover:text-white">{item.label}</a>
              </li>
            ))}
          </ul>
          <a
            href="/#contacto"
            class="mobile-link mt-4 block rounded-control bg-white py-3.5 text-center font-bold text-nova active:scale-[0.98]"
          >
            Contacto
          </a>
        </div>
      </nav>
    </header>

    <div id="contenido" class="pt-24 md:pt-32">
      <slot />
    </div>

    <footer class="mt-20 border-t border-white/10 bg-nova-deep px-6 pt-16 pb-10">
      <div class="mx-auto max-w-7xl">
        <div class="mb-12 grid grid-cols-1 gap-10 md:grid-cols-2 md:gap-12 lg:grid-cols-4">
          <div class="space-y-5 text-center md:text-left">
            <img
              src="/nova-logo.avif"
              alt="Nova Consulting"
              width="512"
              height="218"
              loading="lazy"
              class="mx-auto md:mx-0 h-10 w-auto opacity-90"
            />
            <p class="text-sm leading-relaxed text-sky-soft/80">
              Soluciones estratégicas y compromiso profesional en Canarias.
            </p>
            <div class="space-y-1">
              <p class="text-sm font-medium text-white">Horario de atención</p>
              <p class="text-sm text-sky-soft/80">{SITE.hoursLabel}</p>
              <p class="text-lg font-bold text-sky">{SITE.hoursRange}</p>
            </div>
          </div>

          <nav aria-label="Navegación del pie" class="text-center md:text-left">
            <h2 class="mb-5 text-sm font-bold text-white">Navegación</h2>
            <ul class="text-sm text-sky-soft/80">
              <li><a href="/#servicios" class="inline-block py-2.5 hover:text-white transition-colors">Servicios</a></li>
              <li><a href="/#nosotros" class="inline-block py-2.5 hover:text-white transition-colors">Sobre nosotros</a></li>
              <li><a href="/#sectores" class="inline-block py-2.5 hover:text-white transition-colors">Sectores</a></li>
              <li>
                <a href="/formulario-rentas" class="inline-block py-2.5 font-bold text-sky hover:text-white transition-colors">
                  Campaña de la Renta
                </a>
              </li>
            </ul>
          </nav>

          <nav aria-label="Legal" class="text-center md:text-left">
            <h2 class="mb-5 text-sm font-bold text-white">Legal</h2>
            <ul class="text-sm text-sky-soft/80">
              <li><a href="/legal/avisolegal" class="inline-block py-2.5 hover:text-white transition-colors">Aviso legal</a></li>
              <li><a href="/legal/privacidad" class="inline-block py-2.5 hover:text-white transition-colors">Privacidad</a></li>
              <li><a href="/legal/cookies" class="inline-block py-2.5 hover:text-white transition-colors">Cookies</a></li>
            </ul>
          </nav>

          <div class="text-center md:text-left">
            <h2 class="mb-5 text-sm font-bold text-white">Contacto</h2>
            <address class="not-italic text-sm text-sky-soft/80">
              <a
                href={SITE.mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="flex min-h-11 items-center justify-center gap-3 hover:text-white transition-colors md:justify-start"
              >
                <Icon name="map-pin" class="size-5 text-sky" />
                <span>{SITE.locality}, Tenerife<span class="sr-only"> (abre Google Maps)</span></span>
              </a>
              <a href={SITE.phoneHref} class="flex min-h-11 items-center justify-center gap-3 hover:text-white transition-colors md:justify-start">
                <Icon name="phone" class="size-5 text-sky" />
                <span>{SITE.phone}</span>
              </a>
              <a href={`mailto:${SITE.email}`} class="flex min-h-11 items-center justify-center gap-3 hover:text-white transition-colors md:justify-start">
                <Icon name="envelope-simple" class="size-5 text-sky" />
                <span>{SITE.email}</span>
              </a>
            </address>
            <a
              href={SITE.mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-6 inline-flex items-center gap-2 rounded-control border border-white/20 px-4 py-2.5 text-sm font-medium text-white transition-colors hover:bg-white/10"
            >
              Cómo llegar
              <Icon name="arrow-up-right" class="size-4" />
            </a>
          </div>
        </div>

        <div
          class="mb-8 h-32 w-full overflow-hidden rounded-2xl border border-white/10 opacity-30 grayscale transition-all duration-700 hover:opacity-100"
        >
          <iframe
            title="Mapa con la ubicación de Canarias Nova Consulting en La Laguna"
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3507.53202365819!2d-16.3113931247175!3d28.46352027575746!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xc41cd5ddbdeb109%3A0x4882143824126fa6!2sCanarias%20Nova%20Consulting%20SL!5e0!3m2!1ses!2ses!4v1775046321151!5m2!1ses!2ses"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>

        <div class="border-t border-white/10 pt-8 text-center">
          <p class="text-xs text-sky-soft/70">© {year} {SITE.legalName}. Todos los derechos reservados.</p>
        </div>
      </div>
    </footer>

    <script>
      // Menú móvil accesible: aria-expanded, Escape, cierre al navegar o al hacer clic fuera.
      const toggle = document.getElementById("menu-toggle");
      const menu = document.getElementById("mobile-menu");
      const openIcon = toggle?.querySelector<HTMLElement>('[data-icon="open"]');
      const closeIcon = toggle?.querySelector<HTMLElement>('[data-icon="close"]');

      function setMenu(open: boolean) {
        if (!toggle || !menu) return;
        menu.dataset.open = String(open);
        toggle.setAttribute("aria-expanded", String(open));
        toggle.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
        if (openIcon) openIcon.hidden = open;
        if (closeIcon) closeIcon.hidden = !open;
      }

      toggle?.addEventListener("click", () => setMenu(menu?.dataset.open !== "true"));
      document.querySelectorAll(".mobile-link").forEach((a) => a.addEventListener("click", () => setMenu(false)));
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && menu?.dataset.open === "true") {
          setMenu(false);
          toggle?.focus();
        }
      });
      document.addEventListener("click", (e) => {
        if (menu?.dataset.open === "true" && !(e.target as HTMLElement).closest("nav")) setMenu(false);
      });

      // Entrada al hacer scroll: cada sección tiene su propio estilo (.reveal, .draw, .settle, .unveil en global.css).
      const items = document.querySelectorAll<HTMLElement>(".reveal, .draw, .settle, .unveil");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add("is-visible"));
      }
    </script>
  </body>
</html>
