---
import Layout from "./Layout.astro";
import Icon from "../components/Icon.astro";

interface Props {
  title: string;
  description: string;
  heading: string;
  /** Pagina actual, para no enlazarla en el pie del documento. */
  current: "avisolegal" | "privacidad" | "cookies";
}

const { title, description, heading, current } = Astro.props;

const docs = [
  { id: "avisolegal", href: "/legal/avisolegal", label: "Aviso legal" },
  { id: "privacidad", href: "/legal/privacidad", label: "Política de privacidad" },
  { id: "cookies", href: "/legal/cookies", label: "Política de cookies" },
].filter((d) => d.id !== current);
---

<Layout title={title} description={description}>
  <main>
    <header class="bg-nova">
      <div class="mx-auto max-w-3xl px-5 pb-10 pt-6 sm:px-6 md:pb-14">
        <a
          href="/"
          class="group inline-flex min-h-11 items-center gap-2 text-sm font-medium text-sky-soft transition-colors hover:text-white"
        >
          <Icon name="arrow-left" weight="bold" class="size-4 transition-transform group-hover:-translate-x-1" />
          Volver al inicio
        </a>
        <h1 class="mt-4 text-4xl font-black leading-[1.08] tracking-tight text-white md:text-5xl">{heading}</h1>
      </div>
    </header>

    <div class="surface-light bg-paper text-ink">
      <div class="mx-auto max-w-3xl px-5 py-12 sm:px-6 md:py-16">
        <article class="legal-prose">
          <slot />
        </article>

        <nav aria-label="Otros documentos legales" class="mt-16 border-t border-ink/15 pt-6">
          <p class="text-sm font-medium text-slate-600">Otros documentos</p>
          <ul class="mt-2 flex flex-wrap gap-x-8">
            {
              docs.map((d) => (
                <li>
                  <a
                    href={d.href}
                    class="inline-flex min-h-11 items-center gap-2 font-bold text-accent underline decoration-accent/40 underline-offset-4 transition-colors hover:decoration-accent"
                  >
                    {d.label}
                    <Icon name="arrow-right" weight="bold" class="size-4" />
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </div>
  </main>
</Layout>

<style is:global>
  /* Texto de lectura: medida de ~65 caracteres, ritmo vertical claro, mas aire sobre cada titulo que debajo. */
  .legal-prose {
    font-size: 1.0625rem;
    line-height: 1.7;
    color: #334155;
  }
  .legal-prose > * + * {
    margin-top: 1rem;
  }
  .legal-prose h2 {
    margin-top: 2.75rem;
    font-size: 1.375rem;
    font-weight: 900;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--color-ink);
  }
  .legal-prose h2 + * {
    margin-top: 0.75rem;
  }
  .legal-prose strong {
    font-weight: 700;
    color: var(--color-ink);
  }
  .legal-prose a {
    font-weight: 700;
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-color: rgb(30 79 216 / 0.4);
    text-underline-offset: 3px;
  }
  .legal-prose a:hover {
    text-decoration-color: currentColor;
  }
  .legal-prose ul {
    list-style: disc;
    padding-left: 1.25rem;
  }
  .legal-prose li + li {
    margin-top: 0.5rem;
  }
  .legal-prose li::marker {
    color: var(--color-accent);
  }
  /* Datos identificativos: pares etiqueta / valor separados por filas, sin barra lateral de color. */
  .legal-prose dl {
    border-top: 1px solid rgb(10 26 63 / 0.15);
  }
  .legal-prose dl > div {
    display: grid;
    gap: 0.25rem;
    padding: 0.875rem 0;
    border-bottom: 1px solid rgb(10 26 63 / 0.15);
  }
  .legal-prose dt {
    font-size: 0.875rem;
    font-weight: 500;
    color: #475569;
  }
  .legal-prose dd {
    margin: 0;
    color: var(--color-ink);
  }
  @media (min-width: 640px) {
    .legal-prose dl > div {
      grid-template-columns: 11rem 1fr;
      gap: 1.5rem;
    }
  }
</style>
