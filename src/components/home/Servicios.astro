---
import Icon from "../Icon.astro";
import { servicios } from "../../data/servicios";
---

<section id="servicios" class="surface-light bg-paper py-16 md:py-28">
  <div class="mx-auto max-w-7xl px-5 sm:px-6">
    <div class="max-w-3xl">
      <h2 class="text-3xl font-black leading-[1.08] tracking-tight text-ink sm:text-4xl md:text-5xl">¿Qué servicios ofrecemos?</h2>
      <p class="mt-5 max-w-prose text-base leading-relaxed text-slate-700 sm:text-lg md:mt-6 md:text-xl">
        Ayudamos a autónomos y empresas a centrarse en hacer crecer su negocio. Nos encargamos de la fiscalidad, la
        contabilidad, lo laboral, las subvenciones y la constitución de sociedades, con un enfoque claro, cercano y
        adaptado a cada realidad.
      </p>
    </div>

    <div class="mt-10 border-t border-ink/15 md:mt-20">
      {
        servicios.map((s) => (
          <article class="grid gap-6 border-b border-ink/15 py-9 md:py-14 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:gap-x-20 lg:gap-y-4">
            <div class="lg:col-start-1 lg:row-start-1">
              <Icon name={s.icon} class="size-10 text-accent md:size-11" />
              <h3 class="mt-4 text-3xl font-black tracking-tight text-ink md:mt-5 md:text-4xl">{s.nombre}</h3>
              <p class="mt-3 max-w-md text-base leading-relaxed text-slate-700 md:mt-4 md:text-lg">{s.resumen}</p>
            </div>
            <ul class="grid content-start gap-3 lg:col-start-2 lg:row-span-2 lg:row-start-1 lg:gap-3.5">
              {s.caracteristicas.map((c) => (
                <li class="flex items-start gap-3 text-base leading-snug text-ink md:text-lg">
                  <Icon name="check" weight="bold" class="mt-0.5 size-5 text-accent" />
                  <span>{c}</span>
                </li>
              ))}
            </ul>
            <a
              href={`/servicios/${s.slug}`}
              class="group inline-flex min-h-11 items-center gap-2 justify-self-start font-bold text-accent underline decoration-accent/30 underline-offset-4 transition-colors hover:text-nova hover:decoration-nova lg:col-start-1 lg:row-start-2 lg:self-start"
            >
              Ver {s.nombre.toLowerCase()}
              <Icon name="arrow-right" weight="bold" class="size-4 transition-transform group-hover:translate-x-1" />
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
