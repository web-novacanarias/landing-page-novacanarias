---
import Icon from "../Icon.astro";

const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<section
  id="newsletter"
  class="surface-light relative my-12 mx-4 overflow-hidden rounded-[2.5rem] border border-white/50 bg-paper py-14 shadow-[0_30px_60px_-15px_rgba(0,35,106,0.2)] md:mx-10"
>
  <div class="absolute top-0 left-1/4 h-64 w-64 -translate-y-1/2 rounded-full bg-blue-200/30 blur-[100px]"></div>
  <div class="absolute bottom-0 right-1/4 h-80 w-80 translate-y-1/2 rounded-full bg-indigo-200/20 blur-[120px]"></div>

  <div class="relative z-10 mx-auto max-w-4xl px-6 text-center">
    <div class="mb-6 flex justify-center">
      <span
        class="inline-flex items-center gap-2 rounded-full border border-blue-100 bg-white px-4 py-1.5 text-[11px] font-bold uppercase tracking-[0.15em] text-blue-700 shadow-sm"
      >
        <span class="relative flex h-2 w-2" aria-hidden="true">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-blue-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-blue-600"></span>
        </span>
        Newsletter Exclusiva
      </span>
    </div>

    <h2 class="mb-5 text-4xl font-black leading-[0.95] tracking-tighter text-nova md:text-6xl">
      Anticípate al <span class="bg-linear-to-r from-blue-600 to-blue-400 bg-clip-text text-transparent">BOE</span>
    </h2>

    <p class="mx-auto mb-10 max-w-xl text-base font-medium leading-relaxed text-slate-700 md:text-lg">
      Traducción directa de cambios legales en <br class="hidden md:block" />
      <span class="font-bold text-nova underline decoration-blue-400/30 decoration-4 underline-offset-8">
        oportunidades fiscales
      </span> para tu empresa.
    </p>

    <div class="mx-auto max-w-2xl">
      <form
        id="newsletter-form"
        data-turnstile-sitekey={siteKey}
        class="relative flex flex-col gap-2 rounded-3xl border border-white bg-white/70 p-2 shadow-xl sm:flex-row"
      >
        <label for="newsletter-email" class="sr-only">Tu email</label>
        <input
          id="newsletter-email"
          type="email"
          name="email"
          inputmode="email"
          autocomplete="email"
          maxlength="254"
          placeholder="Tu mejor email"
          required
          class="flex-1 rounded-2xl bg-white px-8 py-4 text-sm font-semibold text-nova outline-none ring-accent transition-shadow placeholder:text-slate-600 focus-visible:ring-2"
        />

        <div class="hp" aria-hidden="true">
          <label>No rellenar este campo <input type="text" name="website_url" tabindex="-1" autocomplete="off" /></label>
        </div>
        <input type="hidden" name="ts" value="" />
        <div data-turnstile-slot class="empty:hidden"></div>

        <button
          type="submit"
          id="newsletter-btn"
          class="group flex items-center justify-center gap-2 rounded-2xl bg-nova px-10 py-4 text-sm font-black uppercase tracking-tighter text-white shadow-lg transition-all hover:bg-blue-700 active:scale-95 disabled:cursor-not-allowed disabled:opacity-70"
        >
          <span id="newsletter-btn-text">Suscribirme</span>
          <Icon name="arrow-right" weight="bold" class="size-4 transition-transform group-hover:translate-x-1" />
        </button>
      </form>

      <label class="mx-auto mt-4 flex min-h-11 max-w-xl items-start gap-3 py-1 text-left text-sm leading-snug text-slate-700">
        <input
          type="checkbox"
          name="privacidad"
          form="newsletter-form"
          required
          class="mt-0.5 size-6 shrink-0 accent-nova"
        />
        <span>
          He leído y acepto la <a href="/legal/privacidad" class="font-bold text-nova underline underline-offset-2">política de privacidad</a>
          y quiero recibir la newsletter.
        </span>
      </label>

      <p id="newsletter-message" role="status" aria-live="polite" hidden></p>
    </div>

    <div class="mt-8 flex items-center justify-center gap-6 text-xs font-bold uppercase tracking-[0.18em] text-slate-600">
      <span>Solo lo esencial</span>
      <span class="text-nova/30" aria-hidden="true">|</span>
      <span>Sin spam</span>
    </div>
  </div>
</section>

<script>
  import { setupForm } from "../../scripts/forms";

  const form = document.getElementById("newsletter-form") as HTMLFormElement | null;
  const button = document.getElementById("newsletter-btn") as HTMLButtonElement | null;
  const message = document.getElementById("newsletter-message");

  if (form && button && message) {
    setupForm({
      form,
      endpoint: "/api/newsletter",
      button,
      buttonLabel: document.getElementById("newsletter-btn-text"),
      message,
      busyText: "Suscribiendo...",
      successText: "¡Genial! Revisa tu bandeja de entrada (o la carpeta de spam) por si tienes que confirmar tu suscripción.",
      errorText: "Error temporal. Inténtalo de nuevo.",
      successClass: "mt-4 text-center text-sm font-bold text-emerald-800",
      errorClass: "mt-4 text-center text-sm font-bold text-red-700",
    });
  }
</script>
