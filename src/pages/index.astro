---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/home/Hero.astro";
import Destacados from "../components/home/Destacados.astro";
import Servicios from "../components/home/Servicios.astro";
import Nosotros from "../components/home/Nosotros.astro";
import Sectores from "../components/home/Sectores.astro";
import Equipo from "../components/home/Equipo.astro";
import Newsletter from "../components/home/Newsletter.astro";
import Contacto from "../components/home/Contacto.astro";
import Avisos from "../components/home/Avisos.astro";
import { SITE, businessSchema } from "../lib/site";

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE.url}/#web`,
  name: SITE.name,
  url: SITE.url,
  inLanguage: "es-ES",
  publisher: { "@id": `${SITE.url}/#negocio` },
};
---

<Layout
  title="Asesoría fiscal, laboral y contable en Tenerife | Nova Consulting"
  description={SITE.defaultDescription}
  jsonLd={[businessSchema, websiteSchema]}
>
  <main>
    <Hero />
    <Destacados />
    <Servicios />
    <Nosotros />
    <Sectores />
    <Equipo />
    <Newsletter />
    <Contacto />
  </main>
  <Avisos />
</Layout>
