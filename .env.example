# Copia este archivo a .env (local) y a las variables de entorno de Vercel. No subas .env al repositorio.

# Correo del formulario de contacto (Resend)
RESEND_API_KEY=

# Newsletter (MailerLite)
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# Cloudflare Turnstile (anti-bots). Opcional: si no están definidas, el formulario funciona
# solo con honeypot, control de tiempo, comprobación de origen y rate limit.
# La clave pública se publica en el HTML; la secreta nunca sale del servidor.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
